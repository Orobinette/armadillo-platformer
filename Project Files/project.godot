config_version=5

[application]

config/name="Armadillo Platformer"
run/main_scene="res://Scenes/scn_test_environment.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://Art/dillo thumbnail.png"

[autoload]

HapticManager="*res://Scripts/Persistant/HapticManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

